{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with education, programming background, career goals, and current levels",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "educationLevel": { "type": "string", "maxLength": 80 },
        "programmingExperience": { "type": "string", "maxLength": 80 },
        "preferredLanguage": { "type": "string", "maxLength": 50 },
        "careerGoal": { "type": "string", "maxLength": 100 },
        "dailyAvailableTime": { "type": "string", "maxLength": 50 },
        "dailyPreferredStudyTime": { "type": "string", "maxLength": 50 },
        "dsaLevel": { "type": "string", "maxLength": 50 },
        "devLevel": { "type": "string", "maxLength": 50 },
        "targetDate": { "type": "string", "maxLength": 50 },
        "preferredLearningStyle": { "type": "string", "maxLength": 50 },
        "streak": { "type": "number" },
        "longestStreak": { "type": "number" },
        "lastActiveDate": { "type": "string", "maxLength": 30 },
        "totalStudyMinutes": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "name", "email", "careerGoal", "preferredLanguage"]
    },
    "Roadmap": {
      "title": "Roadmap",
      "description": "Adaptive personalized software developer career roadmap generated by AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "currentPhase": { "type": "string", "maxLength": 50 },
        "modules": { "type": "array" },
        "overallProgress": { "type": "number" },
        "generatedAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "title"]
    },
    "DailyPlan": {
      "title": "DailyPlan",
      "description": "Daily personalized AI study plan with time breakdown, tasks, and missions",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "dayNumber": { "type": "number" },
        "date": { "type": "string", "maxLength": 30 },
        "title": { "type": "string", "maxLength": 150 },
        "totalMinutes": { "type": "number" },
        "tasks": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed"] },
        "dailyMission": { "type": "string", "maxLength": 300 },
        "checkInCompleted": { "type": "boolean" },
        "nightReviewCompleted": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "date", "title"]
    },
    "ProblemAttempt": {
      "title": "ProblemAttempt",
      "description": "Coding problem submission with code, approach, classification, and AI mentor guidance",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "problemId": { "type": "string", "maxLength": 100 },
        "problemTitle": { "type": "string", "maxLength": 150 },
        "topic": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 20000 },
        "explanation": { "type": "string", "maxLength": 5000 },
        "approach": { "type": "string", "maxLength": 5000 },
        "classification": { "type": "string", "enum": ["Correct", "Almost correct", "Needs improvement", "Incorrect"] },
        "feedback": { "type": "string", "maxLength": 5000 },
        "hintsGiven": { "type": "number" },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "problemId", "topic"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Quiz results for a topic to measure comprehension and determine revision frequency",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "topicId": { "type": "string", "maxLength": 100 },
        "topicTitle": { "type": "string", "maxLength": 150 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "weakConcepts": { "type": "array" },
        "completedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "topicId", "score", "totalQuestions"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Logged study session with duration, completed items, and focus topics",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "durationMinutes": { "type": "number" },
        "topic": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "completedAt": { "type": "string", "maxLength": 50 },
        "rating": { "type": "number" }
      },
      "required": ["userId", "durationMinutes", "topic"]
    },
    "ProgressSummary": {
      "title": "ProgressSummary",
      "description": "Aggregated progress metrics, strengths, weaknesses, streaks, and analytics",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "overallProgress": { "type": "number" },
        "dsaProgress": { "type": "number" },
        "devProgress": { "type": "number" },
        "problemsSolved": { "type": "number" },
        "problemsAttempted": { "type": "number" },
        "accuracy": { "type": "number" },
        "totalStudyHours": { "type": "number" },
        "currentStreak": { "type": "number" },
        "longestStreak": { "type": "number" },
        "weakTopics": { "type": "array" },
        "strongTopics": { "type": "array" },
        "revisionQueue": { "type": "array" },
        "lastUpdated": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "Unlocked badges and milestones earned by the learner",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "badgeId": { "type": "string", "maxLength": 80 },
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 250 },
        "category": { "type": "string", "maxLength": 50 },
        "unlockedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "badgeId", "title"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Scheduled reminder or mentor encouragement notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 300 },
        "type": { "type": "string", "enum": ["morning", "evening", "night", "achievement", "streak"] },
        "scheduledTime": { "type": "string", "maxLength": 50 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "title", "message"]
    },
    "AIMemoryItem": {
      "title": "AIMemoryItem",
      "description": "Continuous memory items stored by the AI mentor for personalized adaptation",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "concept": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["weak", "revising", "mastered"] },
        "mistakeNotes": { "type": "string", "maxLength": 1000 },
        "revisionCount": { "type": "number" },
        "nextRevisionDate": { "type": "string", "maxLength": 50 },
        "lastAttemptScore": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "concept", "status"]
    },
    "SystemActivity": {
      "title": "SystemActivity",
      "description": "Admin developer audit log for AI interactions and errors",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "details": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["action", "status", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual learner profile"
    },
    "/users/{userId}/roadmaps/{roadmapId}": {
      "schema": "Roadmap",
      "description": "Personalized AI generated developer roadmaps"
    },
    "/users/{userId}/dailyPlans/{planId}": {
      "schema": "DailyPlan",
      "description": "Adaptive daily study plans and missions"
    },
    "/users/{userId}/problemAttempts/{attemptId}": {
      "schema": "ProblemAttempt",
      "description": "Learner code problem attempts and AI feedback"
    },
    "/users/{userId}/quizAttempts/{attemptId}": {
      "schema": "QuizAttempt",
      "description": "Topic comprehension quizzes"
    },
    "/users/{userId}/studySessions/{sessionId}": {
      "schema": "StudySession",
      "description": "Study logs and active study time"
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": "ProgressSummary",
      "description": "Progress metrics and spaced repetition queue"
    },
    "/users/{userId}/achievements/{achievementId}": {
      "schema": "Achievement",
      "description": "Unlocked learning badges"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "NotificationItem",
      "description": "Daily reminders and notification feed"
    },
    "/users/{userId}/aiMemory/{memoryId}": {
      "schema": "AIMemoryItem",
      "description": "AI mentor memory for spaced repetition and weak points"
    },
    "/systemActivities/{activityId}": {
      "schema": "SystemActivity",
      "description": "Developer audit activity log"
    },
    "/roles/{userId}": {
      "schema": "UserRole",
      "description": "RBAC user role assignments (USER, ADMIN, SUPER_ADMIN)"
    },
    "/content_items/{itemId}": {
      "schema": "ContentItem",
      "description": "Admin CMS learning modules and curriculum content"
    },
    "/dsa_problems/{problemId}": {
      "schema": "AdminDSAProblem",
      "description": "Admin authoring repository for coding problems and test suites"
    },
    "/knowledge_feed/{postId}": {
      "schema": "KnowledgeFeedItem",
      "description": "Educational knowledge shorts and feed posts"
    },
    "/community_moderation/{reportId}": {
      "schema": "ModerationReport",
      "description": "Student community moderation reports and resolutions"
    },
    "/competitions/{compId}": {
      "schema": "CompetitionItem",
      "description": "Daily/Weekly/Global coding competitions and hackathons"
    },
    "/opportunities/{oppId}": {
      "schema": "OpportunityItem",
      "description": "Internships, scholarships, bounties, and opportunities"
    },
    "/announcements/{annId}": {
      "schema": "AnnouncementItem",
      "description": "Broadcast in-app notifications and announcements"
    },
    "/feature_flags/{flagId}": {
      "schema": "FeatureFlags",
      "description": "Dynamic platform capability feature flags"
    },
    "/ai_settings/{settingId}": {
      "schema": "AISettingsConfig",
      "description": "AI Socratic directives, progression and safety settings"
    },
    "/admin_audit_logs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Cryptographic immutable admin audit logs"
    }
  }
}
